%% ----------中文摘要----------------
\newcommand{\makeNFUAbstractHeaderZH}{%
  \begin{center}
  
    {\fontsize{14}{14}\selectfont 
    \nfuTitleZH\\
    }
    
    \vspace{3\baselineskip}
    
    {\fontsize{14}{14}\selectfont
      \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}}lr@{}}
        研究生：\nfuStudentZH &
        指導教授：\nfuAdvisorZH
      \end{tabular*}\\
      
      \vspace{3\baselineskip}
      \nfuUniversityZH\nfuInstituteZH
    }
  \end{center}
}

%% ----------English Abstract ------------
\newcommand{\makeNFUAbstractHeaderEN}{%
  \begin{center}
  
    {\fontsize{14}{14}\selectfont 
    \nfuTitleEN\\
    }
    
    \vspace{3\baselineskip}
    
    {\fontsize{14}{14}\selectfont
      \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}}lr@{}}
        Student: \nfuStudentEN &
        Advisor: \nfuAdvisorEN
      \end{tabular*}\\
      
      \vspace{3\baselineskip}
      \nfuInstituteEN\\
      \nfuUniversityEN
    }
  \end{center}
}

%% ----------中文摘要----------------
\newenvironment{NFUAbstractZH}{%
  \clearpage\makeNFUAbstractHeaderZH
  {\fontsize{14}{14}\selectfont
  \begin{center}
  摘要
  \end{center}}
  \addcontentsline{toc}{chapter}{摘要}
}

%% ----------English Abstract ------------
\newenvironment{NFUAbstractEN}{%
  \clearpage\makeNFUAbstractHeaderEN
  {\fontsize{14}{14}\selectfont
  \begin{center}
  ABSTRACT
  \end{center}}
  \addcontentsline{toc}{chapter}{Abstract}
}

%% ---------- 誌謝 ------------
\newenvironment{NFUAcknowledge}{%
  \clearpage
  \begin{center}
      {\fontsize{22}{22}\selectfont\mdseries \textbf{誌謝}\\}
  \end{center}
  \vspace{\baselineskip}
  \addcontentsline{toc}{chapter}{誌謝}
}

%% ---------------- Extended Abstract ----------------
\newenvironment{NFUExtendedAbstract}{%
  \clearpage

  % 加入目錄，但不使用 \chapter*，避免受到正文 chapter 格式影響
  \addcontentsline{toc}{chapter}{Extended Abstract}
  \begin{center}

    {\fontsize{16}{16}\selectfont\bfseries
      Extended Abstract\par
    }
    \vspace{\baselineskip}
    
    {\fontsize{16}{16}\selectfont\bfseries
      \nfuTitleZH\\
      \nfuTitleEN\par
    }
    \vspace{\baselineskip}
    
    {\fontsize{12}{12}\selectfont
      \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}}lr@{}}
        Student: \nfuStudentEN &
        Advisor: \nfuAdvisorEN
      \end{tabular*}\par
    }
    \vspace{\baselineskip}
    
    {\fontsize{12}{12}\selectfont
      \nfuInstituteEN\par
      \nfuCollegeEN, \nfuUniversityEN\par
    }
    \vspace{\baselineskip}

    {\fontsize{16}{16}\selectfont\bfseries
      Abstract\par
    }
  \end{center}

  % Extended Abstract 內文：12pt
  \fontsize{12}{19.2}\selectfont
}{}


%% ----------------------------------------------------------------
%% Chapter / TOC / figure-table formatting (kept close to original NFU class)
%% ----------------------------------------------------------------
\setcounter{tocdepth}{2}
\pagestyle{plain}
\renewcommand{\cftloftitlefont}{\hfill \fontsize{22}{22}\bfseries}  %圖目錄標題
\renewcommand{\cftafterloftitle}{\hfill}
\renewcommand{\cfttoctitlefont}{\hfil \fontsize{22}{22}\bfseries}   %目錄標題
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill \fontsize{22}{22}\bfseries}  %表目錄標題
\renewcommand{\cftafterlottitle}{\hfill}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}  %填滿點線

\newcommand{\nfuNaiveZhNum}[1]{%
  \ifcase#1 零\or 一\or 二\or 三\or 四\or 五\or 六\or 七\or 八\or 九\else #1\fi}


%% ---------------------------------------------------------------
%% Chapter / Section / Subsection formatting
%% ---------------------------------------------------------------

% 章標題
\titleformat{\chapter}
  {\centering\fontsize{22}{22}\selectfont\bfseries}
  {第\nfuNaiveZhNum{\value{chapter}}章}
  {1em}
  {}
  [\vspace{19.2pt}]

\titlespacing*{\chapter}
  {0pt}   % 左側縮排
  {0pt}   % 章標題前距離
  {0pt}   % 章標題後距離


% 節標題
\titleformat{\section}
  {\fontsize{16}{16}\selectfont\bfseries}
  {\thesection}
  {1em}
  {}

\titlespacing*{\section}
  {0pt}
  {\baselineskip}
  {0pt}


% 小節標題
\titleformat{\subsection}
  {\fontsize{14}{14}\selectfont\bfseries}
  {\thesubsection}
  {1em}
  {}

\titlespacing*{\subsection}
  {0pt}
  {0pt}
  {0pt}

% subsection 出現前固定空一行
\AddToHook{cmd/subsection/before}{%
  \par\vspace*{10pt}%
}

\titlecontents{chapter}[0em]{}{\makebox[4.1em][l]{\thecontentslabel}}{}{\cftdotfill{\cftdotsep}\contentspage}


\floatname{algorithm}{演算法}
\renewcommand{\algorithmicrequire}{\textbf{輸入：}}
\renewcommand{\algorithmicensure}{\textbf{輸出：}}
