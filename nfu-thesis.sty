%% Font fallback keeps the project usable on Overleaf and common local installs.
\newcommand{\nfuApplyFonts}{%
  \IfFontExistsTF{\nfuMainFont}{\setmainfont{\nfuMainFont}}{%
    \IfFontExistsTF{TeX Gyre Termes}{\setmainfont{TeX Gyre Termes}}{%
      \IfFontExistsTF{Liberation Serif}{\setmainfont{Liberation Serif}}{\setmainfont{Latin Modern Roman}}%
    }%
  }%
  \IfFontExistsTF{\nfuCJKFont}{%
    \setCJKmainfont{\nfuCJKFont}[AutoFakeBold=2]%
  }{%
    \IfFontExistsTF{AR PL KaitiM Big5}{%
      \setCJKmainfont{AR PL KaitiM Big5}[AutoFakeBold=2]%
    }{%
      \setCJKmainfont{Noto Serif CJK TC}[AutoFakeBold=2]%
    }%
  }%
}

\AtBeginDocument{%
  \nfuApplyFonts
  \setlength{\parindent}{2em}   %%正文首行縮排
  \setlength{\parskip}{0pt}
  %\setstretch{1.05}
  %\singlespacing        %% 中文單行間距
  \fontsize{12}{19.2}\selectfont
  \hypersetup{hidelinks,hypertexnames=false}
}

