}

%% ----------------------------------------------------------------
%% Watermark and page-number transitions
%% ----------------------------------------------------------------
\newcommand{\NFUWatermarkOn}{%
  \IfFileExists{\nfuWatermarkFile}{%
    \CenterWallPaper{0.8}{\nfuWatermarkFile}%
    \setlength{\wpXoffset}{0cm}\setlength{\wpYoffset}{0cm}%
  }{\PackageWarning{nfu-thesis}{Watermark file `\nfuWatermarkFile' not found}}%
}
\newcommand{\NFUWatermarkOff}{\ClearWallPaper}
\newcommand{\NFUFrontMatter}{%
  \clearpage
  \hypersetup{pageanchor=true}%
  \pagenumbering{roman}\setcounter{page}{1}\pagestyle{plain}%
}
\newcommand{\NFUMainMatter}{%
  \clearpage\pagenumbering{arabic}\setcounter{page}{1}\pagestyle{plain}%
}
\newcommand{\NFUAppendix}{\appendix}

